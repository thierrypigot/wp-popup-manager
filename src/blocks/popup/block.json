{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "popup-manager/popup",
	"title": "Popup",
	"category": "design",
	"description": "Accessible popup with Interactivity API support.",
	"supports": {
		"html": false,
		"interactivity": true,
		"inserter": false
	},
	"attributes": {},
	"textdomain": "wp-popup-manager",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
