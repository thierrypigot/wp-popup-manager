{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "popup-manager/popup",
	"title": "Popup",
	"category": "design",
	"description": "Accessible popup with Interactivity API support.",
	"supports": {
		"html": false,
		"interactivity": true,
		"inserter": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true
		},
		"__experimentalBorder": {
			"radius": true
		},
		"shadow": true
	},
	"selectors": {
		"root": ".popup-manager-dialog"
	},
	"attributes": {},
	"textdomain": "wp-popup-manager",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
