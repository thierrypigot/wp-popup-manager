{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "popup-manager/trigger",
	"title": "Popup Trigger",
	"category": "design",
	"description": "Wraps a button to trigger a popup on click.",
	"supports": {
		"html": false,
		"interactivity": true
	},
	"attributes": {
		"popupId": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "wp-popup-manager",
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
